{
  "name": "audio-calibration-mcp",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Cross-platform Model Context Protocol server for Room EQ Wizard measurements, speaker calibration, conservative EQ, and DSP verification",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rew",
    "room-eq-wizard",
    "audio-calibration",
    "speaker-calibration",
    "room-correction",
    "acoustic-measurement",
    "digital-signal-processing",
    "equalization",
    "subwoofer-integration",
    "jamesdsp",
    "camilladsp",
    "equalizer-apo",
    "car-audio",
    "acoustics"
  ],
  "author": "daredoole",
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/daredoole"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daredoole/audio-calibration-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/daredoole/audio-calibration-mcp/issues"
  },
  "homepage": "https://github.com/daredoole/audio-calibration-mcp#readme",
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "assets/",
    "dist/",
    "scripts/validate-release.mjs",
    "skills/",
    "fixtures/reference/",
    "LICENSE",
    "README.md",
    "RELEASE_CHECKLIST.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "audio-calibration": "./dist/cli.cjs"
  },
  "scripts": {
    "build": "esbuild server.mjs --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs && esbuild scripts/audio-calibration-cli.mjs --bundle --platform=node --format=cjs --target=node20 --outfile=dist/cli.cjs",
    "start": "node dist/server.mjs",
    "test": "npm run build && node --test",
    "coverage": "npm run build && c8 --check-coverage --lines 80 --statements 80 --functions 70 --branches 60 --reporter=text-summary --include=core.mjs --include=human-listening.mjs --include=advanced-calibration.mjs --include=lib/*.mjs --include=tool-domains/*.mjs --exclude=server.mjs --exclude=dist/** node --test",
    "validate:release": "node scripts/validate-release.mjs",
    "corpus:verify": "node scripts/verify-reference-corpus.mjs",
    "security:verify": "npm audit --audit-level=moderate && npm audit signatures",
    "pack:check": "npm run build && npm run validate:release && npm pack --dry-run --ignore-scripts",
    "cli": "node dist/cli.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.5.2",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "zod": "4.4.3"
  }
}
